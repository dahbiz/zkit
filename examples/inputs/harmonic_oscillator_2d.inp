# Quick 2D isotropic harmonic oscillator example.
Verbose           = 0
Dimension         = 2
Domain            = -20.0, 20.0, -20.0, 20.0
SplineDegree      = 5
NQuadratures      = 8
KnotSequence      = uniform
NSplines          = 32
Planck            = 1.0
Charge            = 1.0
Mass              = 1.0
MassIsConstant    = 1
Potential         = 0.5 * 1.0 * 0.2 * 0.2 * (x*x + y*y)
PotentialDerivativeX = 0.2 * 0.2 * x
PotentialDerivativeY = 0.2 * 0.2 * y
PotentialDerivativeZ = 0
UseDirectSolve    = 0
TargetEigenvalue  = 0.0
NBoundStates      = 6
NBoundStatesSave  = 1
EnablePropagation = 0
EnableCAP         = 0
Polarization      = x
