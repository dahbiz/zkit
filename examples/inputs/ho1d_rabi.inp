# Driven 1D harmonic oscillator: a short resonant field pulse.
# The field frequency (0.2 a.u.) matches the E1-E0 spacing.
Verbose           = 0
Dimension         = 1
Domain            = -20.0, 20.0
SplineDegree      = 5
NQuadratures      = 8
KnotSequence      = uniform
NSplines          = 80
Planck            = 1.0
Charge            = 1.0
Mass              = 1.0
MassIsConstant    = 1
Potential         = 0.5 * 1.0 * 0.2 * 0.2 * x * x
PotentialDerivativeX = 0.2 * 0.2 * x
UseDirectSolve    = 0
TargetEigenvalue  = 0.0
NBoundStates      = 3
NBoundStatesSave  = 1
InitialState      = state:0
NormalizeInitialState = 1
EnablePropagation = 1
TimeStep          = 0.2
FinalTime         = 100.0
OutputStrideTS    = 1
OutputStrideAC    = 1
EnableCAP         = 0
LaserX            = 0.05*sin(0.2*t)
Polarization      = x
