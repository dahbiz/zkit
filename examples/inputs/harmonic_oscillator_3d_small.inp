# Small 3D harmonic oscillator smoke test.
Verbose           = 0
Dimension         = 3
Domain            = -15.0, 15.0, -15.0, 15.0, -15.0, 15.0
SplineDegree      = 3
NQuadratures      = 8
KnotSequence      = uniform
NSplines          = 8
Planck            = 1.0
Charge            = 1.0
Mass              = 1.0
MassIsConstant    = 1
Potential         = 0.5 * 1.0 * 0.2 * 0.2 * (x*x + y*y + z*z)
PotentialDerivativeX = 0.2 * 0.2 * x
PotentialDerivativeY = 0.2 * 0.2 * y
PotentialDerivativeZ = 0.2 * 0.2 * z
UseDirectSolve    = 0
TargetEigenvalue  = 0.0
NBoundStates      = 1
NBoundStatesSave  = 1
EnablePropagation = 0
EnableCAP         = 0
Polarization      = x
